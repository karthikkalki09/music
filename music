<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=0.9">
  <title>Tedpole Music</title>
  <script src="https://unpkg.com/howler@2.2.3/dist/howler.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <style>
    /* Base Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    :root {
      --primary-color: #1DB954;
      --dark-bg: #191414;
      --dark-secondary: #121212;
      --dark-tertiary: #282828;
      --light-text: #FFFFFF;
      --light-secondary: #B3B3B3;
      --light-bg: #FFFFFF;
      --light-secondary-bg: #F5F5F5;
      --light-text-dark: #333333;
    }

    body {
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    .tedpole-music {
      display: grid;
      grid-template-rows: auto 1fr auto;
      grid-template-columns: auto 1fr;
      height: 100%;
      color: var(--light-text);
    }

    /* Dark/Light Mode */
    .dark {
      background-color: var(--dark-bg);
      color: var(--light-text);
    }

    .light {
      background-color: var(--light-bg);
      color: var(--light-text-dark);
    }

    .dark .sidebar,
    .dark .player-bar {
      background-color: var(--dark-secondary);
    }

    .light .sidebar,
    .light .player-bar {
      background-color: var(--light-secondary-bg);
    }

    .dark .main-content {
      background: linear-gradient(to bottom, #1a1a1a, #121212);
    }

    .light .main-content {
      background: linear-gradient(to bottom, #f0f0f0, #e0e0e0);
    }

    /* Sidebar Styles */
    .sidebar {
      grid-row: 1 / -1;
      display: flex;
      flex-direction: column;
      width: 240px;
      padding: 20px;
      overflow-y: auto;
    }

    .logo {
      display: flex;
      align-items: center;
      margin-bottom: 30px;
    }

    .logo h1 {
      margin-left: 10px;
      font-size: 24px;
      font-weight: 700;
    }

    .tedpole-icon {
      position: relative;
      width: 40px;
      height: 40px;
    }

    .teddy-head {
      position: absolute;
      width: 30px;
      height: 30px;
      background-color: var(--primary-color);
      border-radius: 50%;
      top: 0;
      left: 0;
    }

    .tadpole-tail {
      position: absolute;
      width: 20px;
      height: 10px;
      background-color: var(--primary-color);
      border-radius: 10px 0 0 10px;
      top: 15px;
      left: 25px;
    }

    .nav-menu ul {
      list-style: none;
      margin-bottom: 30px;
    }

    .nav-menu li {
      padding: 10px 0;
      cursor: pointer;
      font-weight: 600;
      display: flex;
      align-items: center;
    }

    .nav-menu li i {
      margin-right: 15px;
      width: 20px;
      text-align: center;
    }

    .nav-menu li.active {
      color: var(--primary-color);
    }

    .user-profile {
      margin-top: auto;
      display: flex;
      align-items: center;
      padding: 10px;
      border-radius: 5px;
      background-color: rgba(255, 255, 255, 0.1);
    }

    .user-profile .avatar {
      width: 30px;
      height: 30px;
      background-color: var(--primary-color);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      font-weight: bold;
    }

    .auth-buttons {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .auth-buttons button {
      padding: 10px;
      border-radius: 20px;
      border: none;
      font-weight: 600;
      cursor: pointer;
    }

    .auth-buttons button:first-child {
      background-color: transparent;
      border: 1px solid var(--light-text);
      color: var(--light-text);
    }

    .auth-buttons button:last-child {
      background-color: var(--light-text);
      color: var(--dark-bg);
    }

    .logout-btn {
      background: none;
      border: none;
      color: var(--light-text);
      cursor: pointer;
      margin-left: auto;
    }

    /* Main Content Styles */
    .main-content {
      grid-column: 2;
      grid-row: 1 / span 1;
      overflow-y: auto;
      padding: 20px 30px;
    }

    .view {
      display: none;
    }

    .view.active {
      display: block;
    }

    h2 {
      margin-bottom: 30px;
      font-size: 28px;
    }

    .featured-section, .recently-played, .browse-categories {
      margin-bottom: 40px;
    }

    h3 {
      margin-bottom: 20px;
      font-size: 22px;
    }

    .playlist-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
    }

    .playlist-card {
      background-color: rgba(255, 255, 255, 0.05);
      padding: 15px;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .playlist-card:hover {
      background-color: rgba(255, 255, 255, 0.1);
      transform: translateY(-5px);
    }

    .playlist-card img {
      width: 100%;
      border-radius: 5px;
      margin-bottom: 10px;
    }

    .playlist-card h4 {
      margin-bottom: 5px;
      font-size: 16px;
    }

    .playlist-card p {
      font-size: 14px;
      color: var(--light-secondary);
    }

    .song-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .song-item {
      display: flex;
      align-items: center;
      padding: 10px;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .dark .song-item:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }

    .light .song-item:hover {
      background-color: rgba(0, 0, 0, 0.05);
    }

    .song-item.active {
      background-color: rgba(29, 185, 84, 0.2);
    }

    .song-item img {
      width: 50px;
      height: 50px;
      border-radius: 5px;
      margin-right: 15px;
    }

    .song-info {
      flex: 1;
    }

    .song-info h4 {
      margin-bottom: 5px;
      font-size: 16px;
    }

    .song-info p {
      font-size: 14px;
      color: var(--light-secondary);
    }

    .song-item span {
      margin-left: auto;
      font-size: 14px;
      color: var(--light-secondary);
    }

    .song-actions {
      display: none;
      margin-left: 20px;
    }

    .song-item:hover .song-actions {
      display: block;
    }

    .add-to-playlist {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 12px;
      margin-right: 10px;
    }

    .add-to-playlist:hover {
      color: var(--primary-color);
    }

    .search-bar {
      position: relative;
      margin-bottom: 30px;
    }

    .search-bar i {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--light-secondary);
    }

    .search-bar input {
      width: 100%;
      padding: 12px 20px 12px 45px;
      border-radius: 25px;
      border: none;
      font-size: 16px;
    }

    .dark .search-bar input {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--light-text);
    }

    .light .search-bar input {
      background-color: rgba(0, 0, 0, 0.05);
      color: var(--light-text-dark);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
    }

    .category-card {
      height: 120px;
      border-radius: 5px;
      display: flex;
      align-items: flex-end;
      padding: 15px;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .category-card:hover {
      transform: scale(1.03);
    }

    .category-card h4 {
      font-size: 22px;
      color: white;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .create-playlist-btn {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 8px 15px;
      border-radius: 20px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .login-prompt {
      text-align: center;
      margin-top: 100px;
    }

    .login-prompt p {
      margin-bottom: 20px;
      font-size: 18px;
    }

    .login-prompt button {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 10px 25px;
      border-radius: 25px;
      font-weight: 600;
      cursor: pointer;
    }

    .playlist-detail-view .playlist-header {
      display: flex;
      align-items: flex-end;
      gap: 30px;
      margin-bottom: 30px;
    }

    .playlist-detail-view .playlist-header img {
      width: 200px;
      height: 200px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .playlist-info p:first-child {
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 1px;
      margin-bottom: 5px;
    }

    .playlist-info h2 {
      font-size: 48px;
      margin-bottom: 10px;
    }

    /* Player Bar Styles */
    .player-bar {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 20px;
      height: 80px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .light .player-bar {
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .now-playing {
      display: flex;
      align-items: center;
      width: 250px;
    }

    .now-playing img {
      width: 50px;
      height: 50px;
      margin-right: 15px;
    }

    .now-playing .song-info h4 {
      font-size: 14px;
      margin-bottom: 5px;
    }

    .now-playing .song-info p {
      font-size: 12px;
      color: var(--light-secondary);
    }

    .like-btn {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      margin-left: 15px;
    }

    .like-btn:hover {
      color: var(--primary-color);
    }

    .player-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-bottom: 10px;
    }

    .control-btn {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 16px;
    }

    .control-btn:hover {
      color: var(--light-text);
    }

    .play-btn {
      background: none;
      border: none;
      background-color: var(--light-text);
      color: var(--dark-bg);
      width: 35px;
      height: 35px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .light .play-btn {
      background-color: var(--dark-bg);
      color: var(--light-text);
    }

    .progress-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      max-width: 600px;
    }

    .progress-container {
      flex: 1;
      height: 4px;
      background-color: rgba(255, 255, 255, 0.3);
      border-radius: 2px;
      cursor: pointer;
    }

    .light .progress-container {
      background-color: rgba(0, 0, 0, 0.2);
    }

    .progress {
      height: 100%;
      background-color: var(--primary-color);
      border-radius: 2px;
      position: relative;
    }

    .progress::after {
      content: '';
      position: absolute;
      right: -5px;
      top: 50%;
      transform: translateY(-50%);
      width: 10px;
      height: 10px;
      background-color: var(--light-text);
      border-radius: 50%;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .light .progress::after {
      background-color: var(--dark-bg);
    }

    .progress-container:hover .progress::after {
      opacity: 1;
    }

    .time {
      font-size: 12px;
      color: var(--light-secondary);
      min-width: 40px;
    }

    .player-right {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .lyrics-btn {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .lyrics-btn.active {
      color: var(--primary-color);
    }

    .lyrics-btn:hover {
      color: var(--light-text);
    }

    .volume-control {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .volume-control i {
      color: var(--light-secondary);
      font-size: 14px;
    }

    .volume-control input {
      width: 80px;
    }

    .theme-toggle {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 16px;
    }

    .theme-toggle:hover {
      color: var(--light-text);
    }

    /* Lyrics Panel */
    .lyrics-panel {
      position: fixed;
      bottom: 80px;
      right: 0;
      width: 350px;
      height: calc(100vh - 80px);
      background-color: var(--dark-tertiary);
      z-index: 100;
      padding: 20px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }

    .light .lyrics-panel {
      background-color: var(--light-secondary-bg);
    }

    .lyrics-panel.show {
      transform: translateX(0);
    }

    .lyrics-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .light .lyrics-header {
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .lyrics-header h3 {
      font-size: 18px;
    }

    .lyrics-header button {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 18px;
    }

    .lyrics-content {
      white-space: pre-line;
      line-height: 1.6;
    }

    /* Auth Modals */
    .auth-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .auth-modal.show {
      display: flex;
    }

    .auth-content {
      background-color: var(--dark-secondary);
      padding: 30px;
      border-radius: 10px;
      width: 450px;
      max-width: 90%;
    }

    .light .auth-content {
      background-color: var(--light-bg);
    }

    .auth-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .auth-header h2 {
      font-size: 24px;
    }

    .auth-header button {
      background: none;
      border: none;
      color: var(--light-secondary);
      cursor: pointer;
      font-size: 20px;
    }

    .auth-social {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 20px;
    }

    .social-btn {
      padding: 10px;
      border-radius: 20px;
      border: none;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .social-btn.google {
      background-color: #4285F4;
      color: white;
    }

    .social-btn.apple {
      background-color: #000000;
      color: white;
    }

    .social-btn.facebook {
      background-color: #1877F2;
      color: white;
    }

    .divider {
      position: relative;
      margin: 20px 0;
      text-align: center;
    }

    .divider::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
      background-color: rgba(255, 255, 255, 0.2);
      z-index: -1;
    }

    .light .divider::before {
      background-color: rgba(0, 0, 0, 0.1);
    }

    .divider span {
      background-color: var(--dark-secondary);
      padding: 0 15px;
    }

    .light .divider span {
      background-color: var(--light-bg);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .form-group input {
      width: 100%;
      padding: 12px;
      border-radius: 5px;
      border: none;
      font-size: 16px;
    }

    .dark .form-group input {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--light-text);
    }

    .light .form-group input {
      background-color: rgba(0, 0, 0, 0.05);
      color: var(--light-text-dark);
      border: 1px solid rgba(0, 0, 0, 0.1);
    }

    .auth-submit {
      width: 100%;
      padding: 12px;
      background-color: var(--primary-color);
      color: white;
      border: none;
      border-radius: 25px;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      margin-top: 10px;
    }

    .auth-footer {
      margin-top: 20px;
      text-align: center;
      font-size: 14px;
    }

    .auth-footer button {
      background: none;
      border: none;
      color: var(--primary-color);
      cursor: pointer;
      font-weight: 600;
    }

    .forgot-password {
      color: var(--light-secondary) !important;
      font-weight: normal !important;
    }

    /* Create Playlist Modal */
    .create-playlist-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .create-playlist-modal.show {
      display: flex;
    }

    .modal-content {
      background-color: var(--dark-tertiary);
      padding: 25px;
      border-radius: 10px;
      width: 400px;
      max-width: 90%;
    }

    .modal-content h3 {
      margin-bottom: 20px;
    }

    .modal-content input {
      width: 100%;
      padding: 10px;
      margin-bottom: 20px;
      border-radius: 5px;
      border: none;
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--light-text);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .modal-actions button:first-child {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 8px 15px;
      border-radius: 5px;
      cursor: pointer;
    }

    .modal-actions button:last-child {
      background: none;
      border: 1px solid var(--light-secondary);
      color: var(--light-text);
      padding: 8px 15px;
      border-radius: 5px;
      cursor: pointer;
    }

    /* Responsive Styles */
    @media (max-width: 768px) {
      .tedpole-music {
        grid-template-columns: 1fr;
        grid-template-rows: auto 1fr auto;
      }

      .sidebar {
        grid-row: 1;
        grid-column: 1;
        width: 100%;
        flex-direction: row;
        padding: 10px;
        align-items: center;
      }

      .logo h1 {
        display: none;
      }

      .nav-menu ul {
        display: flex;
        margin-bottom: 0;
        margin-left: 20px;
      }

      .nav-menu li {
        padding: 0 10px;
      }

      .nav-menu li i {
        margin-right: 0;
      }

      .nav-menu li span {
        display: none;
      }

      .user-profile, .auth-buttons {
        margin-left: auto;
        margin-top: 0;
      }

      .main-content {
        grid-column: 1;
        grid-row: 2;
      }

      .player-bar {
        flex-direction: column;
        height: auto;
        padding: 10px;
      }

      .player-left, .player-center, .player-right {
        width: 100%;
      }

      .now-playing {
        width: auto;
        margin-bottom: 10px;
      }

      .player-controls {
        margin-bottom: 5px;
      }

      .progress-bar {
        margin-bottom: 10px;
      }

      .lyrics-panel {
        width: 100%;
        height: 50vh;
        bottom: auto;
        top: 100%;
        transform: translateY(0);
      }

      .lyrics-panel.show {
        transform: translateY(-100%);
      }
    }
  </style>
</head>
<body class="tedpole-music dark">
  <!-- Sidebar -->
  <div class="sidebar">
    <div class="logo">
      <div class="tedpole-icon">
        <div class="teddy-head"></div>
        <div class="tadpole-tail"></div>
      </div>
      <h1>Tedpole Music</h1>
    </div>
    <nav class="nav-menu">
      <ul>
        <li data-tab="home" class="active"><i class="fas fa-home"></i> Home</li>
        <li data-tab="search"><i class="fas fa-search"></i> Search</li>
        <li data-tab="library"><i class="fas fa-music"></i> Your Library</li>
      </ul>
    </nav>
    <div class="auth-buttons">
      <button id="signup-btn">Sign Up</button>
      <button id="login-btn">Log In</button>
    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <div id="home-view" class="view active">
      <h2>Welcome to Tedpole Music</h2>
      <div class="featured-section">
        <h3>Featured Playlists</h3>
        <div class="playlist-grid"></div>
      </div>
      <div class="recently-played">
        <h3>Recently Played</h3>
        <div class="song-list"></div>
      </div>
    </div>
    <div id="search-view" class="view">
      <div class="search-bar">
        <i class="fas fa-search"></i>
        <input type="text" id="search-input" placeholder="Search for songs, artists, or albums">
      </div>
      <div class="search-results"></div>
    </div>
    <div id="library-view" class="view">
      <h2>Your Library</h2>
      <div class="library-content"></div>
