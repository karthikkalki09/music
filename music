        <p><button type="button" class="forgot-password">Forgot password?</button></p>
      </div>
    </div>
  </div>

  <!-- Signup Modal -->
  <div id="signup-modal" class="auth-modal">
    <div class="auth-content">
      <div class="auth-header">
        <h2>Sign up for Tedpole Music</h2>
        <button class="close-modal"><i class="fas fa-times"></i></button>
      </div>
      <div class="auth-social">
        <button type="button" class="social-btn google"><i class="fab fa-google"></i> Continue with Google</button>
        <button type="button" class="social-btn apple"><i class="fab fa-apple"></i> Continue with Apple</button>
        <button type="button" class="social-btn facebook"><i class="fab fa-facebook"></i> Continue with Facebook</button>
      </div>
      <div class="divider"><span>or</span></div>
      <form id="signup-form">
        <div class="form-group">
          <label>Email address</label>
          <input type="email" id="signup-email" required>
        </div>
        <div class="form-group">
          <label>Username</label>
          <input type="text" id="signup-username" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="signup-password" required minlength="8">
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" id="signup-confirm-password" required minlength="8">
        </div>
        <button type="submit" class="auth-submit">Sign Up</button>
      </form>
      <p id="signup-error" style="color: red; display: none;"></p>
      <div class="auth-footer">
        <p>Already have an account? <button type="button" id="switch-to-login">Log in</button></p>
      </div>
    </div>
  </div>

  <!-- Create Playlist Modal -->
  <div id="create-playlist-modal" class="create-playlist-modal">
    <div class="modal-content">
      <h3>Create Playlist</h3>
      <input type="text" id="playlist-name" placeholder="Playlist name">
      <div class="modal-actions">
        <button id="create-playlist-submit">Create</button>
        <button id="create-playlist-cancel">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    // Mock Data
    const songs = [
      {
        id: 1,
        title: "Tedpole Groove",
        artist: "The Tadpoles",
        album: "Pond Life",
        duration: "3:45",
        coverArt: "https://via.placeholder.com/150/1DB954/FFFFFF?text=Tedpole1",
        audioSrc: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
        lyrics: "Tedpole music, swimming in the groove\nMaking waves with every move"
      },
      {
        id: 2,
        title: "Lilypad Lounge",
        artist: "Froggy Fresh",
        album: "Water Beats",
        duration: "4:12",
        coverArt: "https://via.placeholder.com/150/1DB954/FFFFFF?text=Tedpole2",
        audioSrc: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
        lyrics: "Chilling on my lilypad, feeling so fine\nMusic floating through the water, so divine"
      },
      {
        id: 3,
        title: "Raindrop Rhythm",
        artist: "Aqua Beats",
        album: "Liquid Sounds",
        duration: "3:18",
        coverArt: "https://via.placeholder.com/150/1DB954/FFFFFF?text=Tedpole3",
        audioSrc: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",
        lyrics: "Pitter patter on the water surface\nCreating music with a special purpose"
      }
    ];

    let playlists = [
      {
        id: 1,
        name: "Chill Pond Vibes",
        creator: "User123",
        songs: [1, 2],
        coverArt: "https://via.placeholder.com/150/1DB954/FFFFFF?text=Chill"
      },
      {
        id: 2,
        name: "Upbeat Swimmers",
        creator: "User456",
        songs: [3],
        coverArt: "https://via.placeholder.com/150/1DB954/FFFFFF?text=Upbeat"
      }
    ];

    // State
    let state = {
      songs: songs,
      playlists: playlists,
      currentSong: null,
      isPlaying: false,
      volume: 0.7,
      progress: 0,
      duration: 0,
      currentTime: 0,
      showLyrics: false,
      darkMode: true,
      searchQuery: '',
      user: null,
      activeTab: 'home',
      selectedPlaylist: null
    };

    // Users
    let users = JSON.parse(localStorage.getItem('users')) || [];

    // Load playlists from localStorage or use default
    state.playlists = JSON.parse(localStorage.getItem('playlists')) || playlists;

    // Check for current user
    const currentUserEmail = localStorage.getItem('currentUserEmail');
    if (currentUserEmail) {
      const user = users.find(u => u.email === currentUserEmail);
      if (user) {
        state.user = { email: user.email, username: user.username };
      }
    }

    // Audio
    let sound = null;
    let progressInterval = null;

    // DOM Elements
    const sidebar = document.querySelector('.sidebar');
    const mainContent = document.querySelector('.main-content');
    const playerBar = document.querySelector('.player-bar');
    const lyricsPanel = document.querySelector('.lyrics-panel');
    const loginModal = document.querySelector('#login-modal');
    const signupModal = document.querySelector('#signup-modal');
    const createPlaylistModal = document.querySelector('#create-playlist-modal');

    // Helper Functions
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function updateProgress() {
      if (sound && sound.playing()) {
        const seek = sound.seek();
        state.currentTime = seek;
        state.progress = (seek / state.duration) * 100;
        document.querySelector('.progress').style.width = `${state.progress}%`;
        document.querySelector('.time:first-child').textContent = formatTime(seek);
      }
    }

    function startProgressTimer() {
      clearInterval(progressInterval);
      progressInterval = setInterval(updateProgress, 1000);
    }

    // Audio Functions
    function loadSong(song) {
      if (sound) {
        sound.unload();
      }
      sound = new Howl({
        src: [song.audioSrc],
        html5: true,
        volume: state.volume,
        onplay: () => {
          state.isPlaying = true;
          state.duration = sound.duration();
          startProgressTimer();
          updateUI();
        },
        onend: () => {
          state.isPlaying = false;
          clearInterval(progressInterval);
          state.progress = 0;
          state.currentTime = 0;
          updateUI();
        },
        onpause: () => {
          state.isPlaying = false;
          clearInterval(progressInterval);
          updateUI();
        },
        onstop: () => {
          state.isPlaying = false;
          clearInterval(progressInterval);
          state.progress = 0;
          state.currentTime = 0;
          updateUI();
        }
      });
      sound.play();
      state.currentSong = song;
      updateUI();
    }

    function togglePlay() {
      if (!state.currentSong) return;
      if (state.isPlaying) {
        sound.pause();
      } else {
        sound.play();
      }
    }

    // UI Update Function
    function updateUI() {
      // Player Bar
      const nowPlaying = document.querySelector('.now-playing');
      if (state.currentSong) {
        nowPlaying.innerHTML = `
          <img src="${state.currentSong.coverArt}" alt="${state.currentSong.title}">
          <div class="song-info">
            <h4>${state.currentSong.title}</h4>
            <p>${state.currentSong.artist}</p>
          </div>
          <button class="like-btn"><i class="far fa-heart"></i></button>
        `;
      } else {
        nowPlaying.innerHTML = '';
      }

      const playBtnIcon = document.querySelector('.play-btn i');
      playBtnIcon.className = state.isPlaying ? 'fas fa-pause' : 'fas fa-play';

      document.querySelector('.time:last-child').textContent = formatTime(state.duration);

      // Theme
      document.body.classList.toggle('dark', state.darkMode);
      document.body.classList.toggle('light', !state.darkMode);
      document.querySelector('.theme-toggle i').className = state.darkMode ? 'fas fa-moon' : 'fas fa-sun';

      // Lyrics Panel
      lyricsPanel.classList.toggle('show', state.showLyrics);
      if (state.showLyrics && state.currentSong) {
        lyricsPanel.querySelector('.lyrics-header h3').textContent = `${state.currentSong.title} - ${state.currentSong.artist}`;
        lyricsPanel.querySelector('.lyrics-content p').textContent = state.currentSong.lyrics;
      }

      // Navigation
      document.querySelectorAll('.nav-menu li').forEach(li => {
        li.classList.toggle('active', li.dataset.tab === state.activeTab);
      });
      document.querySelectorAll('.view').forEach(view => {
        view.classList.toggle('active', view.id === `${state.activeTab}-view`);
      });

      // User Section
      const userSection = sidebar.querySelector('.auth-buttons') || sidebar.querySelector('.user-profile');
      if (state.user) {
        userSection.classList.remove('auth-buttons');
        userSection.classList.add('user-profile');
        userSection.innerHTML = `
          <div class="avatar">${state.user.username.charAt(0).toUpperCase()}</div>
          <span>${state.user.username}</span>
          <button class="logout-btn"><i class="fas fa-sign-out-alt"></i></button>
        `;
        if (!document.querySelector('.nav-menu li[data-tab="playlists"]')) {
          const playlistsLi = document.createElement('li');
          playlistsLi.dataset.tab = 'playlists';
          playlistsLi.innerHTML = '<i class="fas fa-list"></i> Playlists';
          document.querySelector('.nav-menu ul').appendChild(playlistsLi);
          playlistsLi.addEventListener('click', () => {
            state.activeTab = 'playlists';
            renderPlaylistsView();
            updateUI();
          });
        }
      } else {
        userSection.classList.remove('user-profile');
        userSection.classList.add('auth-buttons');
        userSection.innerHTML = `
          <button id="signup-btn">Sign Up</button>
          <button id="login-btn">Log In</button>
        `;
        const playlistsTab = document.querySelector('.nav-menu li[data-tab="playlists"]');
        if (playlistsTab) playlistsTab.remove();
      }

      // Render Views
      if (state.activeTab === 'home') renderHomeView();
      if (state.activeTab === 'search') renderSearchView();
      if (state.activeTab === 'library') renderLibraryView();
      if (state.activeTab === 'playlists') renderPlaylistsView();
      if (state.activeTab === 'playlist-detail') renderPlaylistDetailView();
    }

    // View Rendering Functions
    function renderHomeView() {
      document.querySelector('.playlist-grid').innerHTML = state.playlists.map(playlist => `
        <div class="playlist-card" data-id="${playlist.id}">
          <img src="${playlist.coverArt}" alt="${playlist.name}">
          <h4>${playlist.name}</h4>
          <p>By ${playlist.creator}</p>
        </div>
      `).join('');
      document.querySelector('.recently-played .song-list').innerHTML = state.songs.slice(0, 3).map(song => `
        <div class="song-item ${state.currentSong?.id === song.id ? 'active' : ''}" data-id="${song.id}">
          <img src="${song.coverArt}" alt="${song.title}">
          <div class="song-info">
            <h4>${song.title}</h4>
            <p>${song.artist}</p>
          </div>
          <span>${song.duration}</span>
        </div>
      `).join('');
    }

    function renderSearchView() {
      const searchResults = document.querySelector('.search-results');
      if (state.searchQuery) {
        const filteredSongs = state.songs.filter(song =>
          song.title.toLowerCase().includes(state.searchQuery.toLowerCase()) ||
          song.artist.toLowerCase().includes(state.searchQuery.toLowerCase()) ||
          song.album.toLowerCase().includes(state.searchQuery.toLowerCase())
        );
        searchResults.innerHTML = `
          <h3>Search Results for "${state.searchQuery}"</h3>
          <div class="song-list">
            ${filteredSongs.map(song => `
              <div class="song-item ${state.currentSong?.id === song.id ? 'active' : ''}" data-id="${song.id}">
                <img src="${song.coverArt}" alt="${song.title}">
                <div class="song-info">
                  <h4>${song.title}</h4>
                  <p>${song.artist} • ${song.album}</p>
                </div>
                <span>${song.duration}</span>
              </div>
            `).join('')}
          </div>
        `;
      } else {
        searchResults.innerHTML = `
          <h3>Browse All</h3>
          <div class="category-grid">
            <div class="category-card" style="background-color: #1DB954;"><h4>Chill</h4></div>
            <div class="category-card" style="background-color: #191414;"><h4>Focus</h4></div>
            <div class="category-card" style="background-color: #535353;"><h4>Party</h4></div>
            <div class="category-card" style="background-color: #1DB954;"><h4>Workout</h4></div>
          </div>
        `;
      }
    }

    function renderLibraryView() {
      const libraryContent = document.querySelector('#library-view .library-content');
      if (state.user) {
        libraryContent.innerHTML = `
          <div class="section-header">
            <h3>Your Songs</h3>
            <button class="create-playlist-btn"><i class="fas fa-plus"></i> New Playlist</button>
          </div>
          <div class="song-list">
            ${state.songs.map(song => `
              <div class="song-item ${state.currentSong?.id === song.id ? 'active' : ''}" data-id="${song.id}">
                <img src="${song.coverArt}" alt="${song.title}">
                <div class="song-info">
                  <h4>${song.title}</h4>
                  <p>${song.artist}</p>
                </div>
                <div class="song-actions">
                  ${state.playlists.filter(p => p.creator === state.user.username).map(playlist => `
                    <button class="add-to-playlist" data-playlist="${playlist.id}" data-song="${song.id}">
                      ${playlist.songs.includes(song.id) ? '<i class="fas fa-check"></i>' : '<i class="fas fa-plus"></i>'} ${playlist.name}
                    </button>
                  `).join('')}
                </div>
                <span>${song.duration}</span>
              </div>
            `).join('')}
          </div>
        `;
      } else {
        libraryContent.innerHTML = `
          <div class="login-prompt">
            <p>Log in to view your library</p>
            <button id="login-prompt-btn">Log In</button>
          </div>
        `;
      }
    }

    function renderPlaylistsView() {
      const userPlaylists = state.playlists.filter(p => p.creator === state.user?.username);
      document.querySelector('#playlists-view .playlist-grid').innerHTML = userPlaylists.map(playlist => `
        <div class="playlist-card" data-id="${playlist.id}">
          <img src="${playlist.coverArt}" alt="${playlist.name}">
          <h4>${playlist.name}</h4>
          <p>${playlist.songs.length} songs</p>
        </div>
      `).join('');
    }

    function renderPlaylistDetailView() {
      if (state.selectedPlaylist) {
        const playlistDetailContent = document.querySelector('#playlist-detail-view .playlist-detail-content');
        playlistDetailContent.innerHTML = `
          <div class="playlist-header">
            <img src="${state.selectedPlaylist.coverArt}" alt="${state.selectedPlaylist.name}">
            <div class="playlist-info">
              <p>PLAYLIST</p>
              <h2>${state.selectedPlaylist.name}</h2>
              <p>Created by ${state.selectedPlaylist.creator}</p>
              <p>${state.selectedPlaylist.songs.length} songs</p>
            </div>
          </div>
          <div class="song-list">
            ${state.songs.filter(song => state.selectedPlaylist.songs.includes(song.id)).map(song => `
              <div class="song-item ${state.currentSong?.id === song.id ? 'active' : ''}" data-id="${song.id}">
                <img src="${song.coverArt}" alt="${song.title}">
                <div class="song-info">
                  <h4>${song.title}</h4>
                  <p>${song.artist}</p>
                </div>
                <span>${song.duration}</span>
              </div>
            `).join('')}
          </div>
        `;
      }
    }

    // Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      updateUI();

      // Navigation
      document.querySelector('.nav-menu').addEventListener('click', (e) => {
        const li = e.target.closest('li');
        if (li) {
          state.activeTab = li.dataset.tab;
          updateUI();
        }
      });

      // Play Button
      document.querySelector('.play-btn').addEventListener('click', togglePlay);

      // Volume Control
      document.querySelector('.volume-control input').addEventListener('input', (e) => {
        state.volume = parseFloat(e.target.value);
        Howler.volume(state.volume);
      });

      // Theme Toggle
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        state.darkMode = !state.darkMode;
        updateUI();
      });

      // Lyrics Toggle
      document.querySelector('.lyrics-btn').addEventListener('click', () => {
        state.showLyrics = !state.showLyrics;
        updateUI();
      });
      document.querySelector('.close-lyrics').addEventListener('click', () => {
        state.showLyrics = false;
        updateUI();
      });

      // Progress Bar Click
      document.querySelector('.progress-container').addEventListener('click', (e) => {
        if (!sound) return;
        const progressBar = e.currentTarget;
        const clickPosition = e.clientX - progressBar.getBoundingClientRect().left;
        const progressBarWidth = progressBar.clientWidth;
        const clickPercentage = clickPosition / progressBarWidth;
        const seekTime = clickPercentage * state.duration;
        sound.seek(seekTime);
        state.currentTime = seekTime;
        state.progress = clickPercentage * 100;
        updateUI();
      });

      // Auth Buttons
      function setupAuthButtons() {
        const signupBtn = document.querySelector('#signup-btn');
        const loginBtn = document.querySelector('#login-btn');
        if (signupBtn) signupBtn.addEventListener('click', () => { loginModal.style.display = 'none'; signupModal.classList.add('show'); });
        if (loginBtn) loginBtn.addEventListener('click', () => { signupModal.style.display = 'none'; loginModal.classList.add('show'); });
      }
      setupAuthButtons();

      // Modal Close Buttons
      document.querySelectorAll('.close-modal').forEach(btn => {
        btn.addEventListener('click', () => {
          btn.closest('.auth-modal').classList.remove('show');
        });
      });

      // Switch Between Modals
      document.querySelector('#switch-to-signup').addEventListener('click', () => {
        loginModal.classList.remove('show');
        signupModal.classList.add('show');
      });
      document.querySelector('#switch-to-login').addEventListener('click', () => {
        signupModal.classList.remove('show');
        loginModal.classList.add('show');
      });

      // Login Form
      document.querySelector('#login-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.querySelector('#login-email').value;
        const password = document.querySelector('#login-password').value;
        const errorElement = document.querySelector('#login-error');
        errorElement.style.display = 'none';
        errorElement.textContent = '';
        const user = users.find(u => u.email === email && u.password === password);
        if (user) {
          state.user = { email: user.email, username: user.username };
          localStorage.setItem('currentUserEmail', email);
          loginModal.classList.remove('show');
          updateUI();
        } else {
          errorElement.textContent = 'Invalid email or password';
          errorElement.style.display = 'block';
        }
      });

      // Signup Form
      document.querySelector('#signup-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.querySelector('#signup-email').value;
        const username = document.querySelector('#signup-username').value;
        const password = document.querySelector('#signup-password').value;
        const confirmPassword = document.querySelector('#signup-confirm-password').value;
        const errorElement = document.querySelector('#signup-error');
        errorElement.style.display = 'none';
        errorElement.textContent = '';
        if (password !== confirmPassword) {
          errorElement.textContent = 'Passwords do not match';
          errorElement.style.display = 'block';
          return;
        }
        const existingUser = users.find(u => u.email === email || u.username === username);
        if (existingUser) {
          errorElement.textContent = 'Email or username already exists';
          errorElement.style.display = 'block';
          return;
        }
        const newUser = { email, username, password };
        users.push(newUser);
        localStorage.setItem('users', JSON.stringify(users));
        state.user = { email, username };
        localStorage.setItem('currentUserEmail', email);
        signupModal.classList.remove('show');
        updateUI();
      });

      // Logout
      sidebar.addEventListener('click', (e) => {
        if (e.target.closest('.logout-btn')) {
          state.user = null;
          localStorage.removeItem('currentUserEmail');
          if (sound) sound.stop();
          state.currentSong = null;
          state.isPlaying = false;
          updateUI();
          setupAuthButtons();
        }
      });

      // Home View Interactions
      mainContent.addEventListener('click', (e) => {
        const playlistCard = e.target.closest('.playlist-card');
        const songItem = e.target.closest('.song-item');
        if (playlistCard) {
          const playlistId = parseInt(playlistCard.dataset.id);
          state.selectedPlaylist = state.playlists.find(p => p.id === playlistId);
          state.activeTab = 'playlist-detail';
          updateUI();
        } else if (songItem) {
          const songId = parseInt(songItem.dataset.id);
          const song = state.songs.find(s => s.id === songId);
          loadSong(song);
        }
      });

      // Search Input
      document.querySelector('#search-input').addEventListener('input', (e) => {
        state.searchQuery = e.target.value;
        renderSearchView();
      });

      // Library Interactions
      document.querySelector('#library-view').addEventListener('click', (e) => {
        if (e.target.closest('#login-prompt-btn')) {
          loginModal.classList.add('show');
        }
        if (e.target.closest('.create-playlist-btn')) {
          createPlaylistModal.classList.add('show');
        }
        const addBtn = e.target.closest('.add-to-playlist');
        if (addBtn) {
          e.stopPropagation();
          const playlistId = parseInt(addBtn.dataset.playlist);
          const songId = parseInt(addBtn.dataset.song);
          const playlist = state.playlists.find(p => p.id === playlistId);
          if (playlist.songs.includes(songId)) {
            playlist.songs = playlist.songs.filter(id => id !== songId);
          } else {
            playlist.songs.push(songId);
          }
          localStorage.setItem('playlists', JSON.stringify(state.playlists));
          renderLibraryView();
        }
      });

      // Create Playlist
      document.querySelector('#create-playlist-submit').addEventListener('click', () => {
        const playlistName = document.querySelector('#playlist-name').value.trim();
        if (playlistName) {
          const newPlaylist = {
            id: state.playlists.length + 1,
            name: playlistName,
            creator: state.user.username,
            songs: [],
            coverArt: `https://via.placeholder.com/150/1DB954/FFFFFF?text=${playlistName.substring(0, 2)}`
          };
          state.playlists.push(newPlaylist);
          localStorage.setItem('playlists', JSON.stringify(state.playlists));
          createPlaylistModal.classList.remove('show');
          document.querySelector('#playlist-name').value = '';
          updateUI();
        }
      });
      document.querySelector('#create-playlist-cancel').addEventListener('click', () => {
        createPlaylistModal.classList.remove('show');
        document.querySelector('#playlist-name').value = '';
      });
    });
  </script>
</body>
</html>
